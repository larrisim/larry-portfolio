# Contact form — copy to `.env.local` for local development, and add the same
# variables in Vercel (Project Settings → Environment Variables, Production).
# Never commit a real `.env.local` — it is gitignored.

# Resend (https://resend.com/api-keys) — sends the contact form emails.
RESEND_API_KEY=

# Where form submissions are delivered.
CONTACT_TO=larry@larry-chang.com

# The "from" address shown on form emails. Use an address on a domain you
# have verified in Resend. For testing, Resend's onboarding sender
# (onboarding@resend.dev) works but only delivers to the account owner's email.
CONTACT_FROM=Larry Chang Portfolio <contact@larry-chang.com>

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# — secret key, server-side only. Never expose this in client code.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key — public, used by the form in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
